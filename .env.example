# ───────────────────────────────────────────────────────────────
# Telegram Tools — Environment template
# Copy this file to `.env` and fill in your credentials.
#   cp .env.example .env
# NEVER commit the real `.env` file — it is git-ignored by default.
# ───────────────────────────────────────────────────────────────

# ── Telegram API credentials (https://my.telegram.org) ─────────
TG_API_ID=12345678
TG_API_HASH=your_api_hash_here
TG_PHONE=+963xxxxxxxxx

# ── Session String (optional — skip interactive login if set) ─
# Export it once from the Web UI (Login tab → "Export Session String")
# then paste here to enable headless automation.
TG_SESSION_STRING=

# ── HuggingFace Hub (optional — for one-click dataset upload) ──
# Create at https://huggingface.co/settings/tokens  (scope: write)
HF_TOKEN=hf_xxx

# ── Default channel for headless_sync.py / weekly action ──────
DEFAULT_CHANNEL=@dr_zaky_ortho

# ── Output directory (corpus, splits, downloads) ──────────────
OUTPUT_DIR=~/omni_telegram_output

# ── Gradio UI ─────────────────────────────────────────────────
PORT=7860

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
